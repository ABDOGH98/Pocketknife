    "Invalid JWT: expected 3 dot-separated parts, found %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JWT غير صالح: يُتوقع 3 أجزاء مفصولة بنقاط، وعُثر على %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiges JWT: 3 durch Punkte getrennte Teile erwartet, %lld gefunden."
