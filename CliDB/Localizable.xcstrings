    "Copied passwords are hidden from clipboard managers and cleared after a minute." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمات المرور المنسوخة مخفية عن مديري الحافظة وتُمسح بعد دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierte Passwörter sind für Zwischenablage-Manager unsichtbar und werden nach einer Minute gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas copiadas se ocultan a los gestores de portapapeles y se borran al cabo de un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe copiés sont masqués aux gestionnaires de presse-papiers et effacés au bout d’une minute."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סיסמאות מועתקות מוסתרות ממנהלי לוח ונמחקות אחרי דקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉपी किए गए पासवर्ड क्लिपबोर्ड मैनेजर से छिपे रहते हैं और एक मिनट बाद मिट जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi yang disalin disembunyikan dari pengelola papan klip dan dihapus setelah satu menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le password copiate sono nascoste ai gestori degli appunti e cancellate dopo un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしたパスワードはクリップボード管理アプリから隠され、1 分後に消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사한 암호는 클립보드 관리자에게 숨겨지고 1분 후에 지워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekopieerde wachtwoorden zijn onzichtbaar voor klembordbeheerders en worden na een minuut gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiowane hasła są ukryte przed menedżerami schowka i usuwane po minucie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senhas copiadas ficam ocultas para gerenciadores de área de transferência e são apagadas após um minuto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопированные пароли скрыты от менеджеров буфера обмена и стираются через минуту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopyalanan parolalar pano yöneticilerinden gizlenir ve bir dakika sonra temizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопійовані паролі приховані від менеджерів буфера обміну й очищуються через хвилину."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu đã sao chép được ẩn khỏi trình quản lý bộ nhớ tạm và bị xóa sau một phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝的密码会对剪贴板管理器隐藏，并在一分钟后清除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷貝的密碼會對剪貼板管理工具隱藏，並在一分鐘後清除。"
          }
        }
      }
    },
