    "Slides, bounces and glowing backgrounds. Always off when Reduce Motion is on in System Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انزلاقات وارتدادات وخلفيات متوهجة. تتوقف دائماً عند تفعيل «تقليل الحركة» في إعدادات النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleiten, Federn und leuchtende Hintergründe. Immer aus, wenn „Bewegung reduzieren“ in den Systemeinstellungen aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslizamientos, rebotes y fondos luminosos. Siempre desactivadas si «Reducir movimiento» está activado en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissements, rebonds et fonds lumineux. Toujours désactivées si « Réduire les animations » est activé dans les Réglages Système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלקות, קפיצות ורקעים זוהרים. תמיד כבוי כש„הפחתת תנועה” מופעלת בהגדרות המערכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्लाइड, बाउंस और चमकते बैकग्राउंड। सिस्टम सेटिंग्ज़ में “गति कम करें” चालू होने पर हमेशा बंद।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser, pantul, dan latar bercahaya. Selalu nonaktif jika Kurangi Gerakan aktif di Pengaturan Sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorrimenti, rimbalzi e sfondi luminosi. Sempre disattivate se “Riduci movimento” è attivo in Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スライド、バウンス、光る背景。システム設定で「視差効果を減らす」がオンのときは常にオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "슬라이드, 바운스, 빛나는 배경. 시스템 설정에서 ‘동작 줄이기’가 켜져 있으면 항상 꺼집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glijden, stuiteren en gloeiende achtergronden. Altijd uit als ‘Verminder beweging’ is ingeschakeld in Systeeminstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesunięcia, odbicia i świecące tła. Zawsze wyłączone, gdy w Ustawieniach systemowych włączona jest opcja Ogranicz ruch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslizes, quiques e fundos luminosos. Sempre desligados quando Reduzir Movimento está ativado nos Ajustes do Sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвиги, отскоки и светящиеся фоны. Всегда выключены, если в Системных настройках включено «Уменьшение движения»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaymalar, sekmeler ve parlayan arka planlar. Sistem Ayarları’nda Hareketi Azalt açıkken her zaman kapalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ковзання, відскоки й сяйні фони. Завжди вимкнено, якщо в Системних параметрах увімкнено «Зменшити рух»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiệu ứng trượt, nảy và nền phát sáng. Luôn tắt khi bật Giảm chuyển động trong Cài đặt hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑动、弹跳和发光背景。在“系统设置”中打开“减弱动态效果”时始终关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑動、彈跳和發光背景。在「系統設定」中開啟「減少動態效果」時一律關閉。"
          }
        }
      }
    },
