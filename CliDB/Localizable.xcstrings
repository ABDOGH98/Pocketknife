    "Optional. Saved values show up as chips you can click when filling in the command." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختياري. تظهر القيم المحفوظة كأزرار صغيرة يمكنك النقر عليها عند تعبئة الأمر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Gesicherte Werte erscheinen beim Ausfüllen des Befehls als anklickbare Chips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Los valores guardados aparecen como chips en los que puedes hacer clic al rellenar el comando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Les valeurs enregistrées apparaissent sous forme de pastilles à cliquer quand vous remplissez la commande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אופציונלי. ערכים שמורים מופיעים כצ׳יפים שאפשר ללחוץ עליהם במילוי הפקודה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वैकल्पिक। सेव की गई वैल्यू कमांड भरते समय क्लिक करने लायक चिप के रूप में दिखती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opsional. Nilai tersimpan muncul sebagai chip yang bisa diklik saat mengisi perintah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. I valori salvati compaiono come chip cliccabili quando compili il comando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。保存した値は、コマンドの入力時にクリックできるチップとして表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항. 저장된 값은 명령어를 채울 때 클릭할 수 있는 칩으로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Bewaarde waarden verschijnen als klikbare chips wanneer je het commando invult."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalne. Zapisane wartości pojawiają się jako chipy, które możesz kliknąć podczas uzupełniania polecenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Os valores salvos aparecem como chips clicáveis quando você preenche o comando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Сохранённые значения появятся в виде чипов, на которые можно нажать при заполнении команды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteğe bağlı. Kayıtlı değerler, komutu doldururken tıklayabileceğiniz çipler olarak görünür."
