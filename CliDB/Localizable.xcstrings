        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç siz yazdıkça burada görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả sẽ hiện ở đây khi bạn nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
