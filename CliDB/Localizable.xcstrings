    "All optional. Favorites stay at the top of the list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلها اختيارية. تبقى المفضلة في أعلى القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles optional. Favoriten stehen oben in der Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo es opcional. Los favoritos se quedan arriba en la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est facultatif. Les favoris restent en haut de la liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब वैकल्पिक है। पसंदीदा सूची में सबसे ऊपर रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua opsional. Favorit tetap di bagian atas daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto facoltativo. I preferiti restano in cima alla lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて任意です。お気に入りはリストの上に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 선택 사항입니다. 즐겨찾기는 목록 맨 위에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles optioneel. Favorieten staan bovenaan de lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko opcjonalne. Ulubione są na górze listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo opcional. Os favoritos ficam no topo da lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё необязательно. Избранное всегда в начале списка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt är valfritt. Favoriter ligger överst i listan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับทั้งหมด รายการโปรดจะอยู่ด้านบนของรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsi isteğe bağlı. Favoriler listenin en üstünde kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả đều tùy chọn. Mục ưa thích luôn ở đầu danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部可选。个人收藏始终显示在列表顶部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部為選填。個人收藏一律顯示在列表最上方。"
          }
        }
      }
    },
