    "Add a part you fill in each time, like a port or a branch name, at the cursor": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدرج عند المؤشر جزءًا تملؤه في كل مرة، مثل منفذ أو اسم فرع"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der Cursorposition einen Teil einfügen, den du jedes Mal ausfüllst, z. B. einen Port oder Branch-Namen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Insertar en el cursor una parte que rellenas cada vez, como un puerto o el nombre de una rama"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insérer au curseur une partie à remplir à chaque fois, comme un port ou un nom de branche"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कर्सर पर वह हिस्सा डालें जिसे आप हर बार भरते हैं, जैसे पोर्ट या ब्रांच का नाम"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisipkan di kursor bagian yang Anda isi setiap kali, seperti port atau nama branch"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci al cursore una parte da compilare ogni volta, come una porta o il nome di un branch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートやブランチ名など、毎回入力する部分をカーソル位置に挿入します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트나 브랜치 이름처럼 매번 채우는 부분을 커서 위치에 삽입합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg bij de cursor een deel in dat je elke keer invult, zoals een poort of branchnaam"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstaw w miejscu kursora część wypełnianą za każdym razem, np. port lub nazwę gałęzi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserir no cursor uma parte que você preenche toda vez, como uma porta ou o nome de um branch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить в позицию курсора часть, которую вы заполняете каждый раз, например порт или имя ветки"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Infoga en del som du fyller i varje gång, som en port eller ett grennamn, vid markören"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทรกส่วนที่คุณกรอกทุกครั้ง เช่น พอร์ตหรือชื่อแบรนช์ ที่ตำแหน่งเคอร์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmlecin olduğu yere, port veya dal adı gibi her seferinde doldurduğunuz bir bölüm ekleyin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chèn tại con trỏ một phần bạn điền mỗi lần, như cổng hoặc tên nhánh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在光标处插入每次都要填写的部分，例如端口或分支名称"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在游標處插入每次都要填寫的部分，例如連接埠或分支名稱"
          }
        }
      }
    },
