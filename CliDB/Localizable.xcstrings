    "Fill in and copy the shell commands you can never quite remember." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبّئ وانسخ أوامر الطرفية التي يصعب تذكّرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell-Befehle ausfüllen und kopieren, die du dir nie ganz merken kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rellena y copia los comandos de shell que nunca consigues recordar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplissez et copiez les commandes shell qu’on n’arrive jamais à retenir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מלאו והעתיקו את פקודות ה-shell שאף פעם לא מצליחים לזכור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे शेल कमांड भरें और कॉपी करें जो कभी ठीक से याद नहीं रहतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isi dan salin perintah shell yang tidak pernah bisa Anda ingat dengan pasti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila e copia i comandi della shell che non riesci mai a ricordare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どうしても覚えられないシェルコマンドを、入力してコピーできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
