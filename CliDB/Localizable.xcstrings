    "Save the commands you use often, then search and copy them in seconds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ الأوامر التي تستخدمها كثيراً، ثم ابحث عنها وانسخها في ثوانٍ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere die Befehle, die du oft brauchst, und finde und kopiere sie in Sekunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda los comandos que usas a menudo y luego búscalos y cópialos en segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez les commandes que vous utilisez souvent, puis retrouvez-les et copiez-les en quelques secondes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמרו את הפקודות שאתם משתמשים בהן לעתים קרובות, ואז חפשו והעתיקו אותן בשניות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अक्सर इस्तेमाल होने वाली कमांड सेव करें, फिर उन्हें सेकंडों में सर्च और कॉपी करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan perintah yang sering Anda pakai, lalu cari dan salin dalam hitungan detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva i comandi che usi spesso, poi cercali e copiali in pochi secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく使うコマンドを保存すれば、数秒で検索してコピーできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자주 쓰는 명령어를 저장하고 몇 초 만에 검색해서 복사하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar de commando’s die je vaak gebruikt, en zoek en kopieer ze in een paar seconden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz często używane polecenia, a potem wyszukuj i kopiuj je w kilka sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve os comandos que você usa com frequência e depois busque e copie-os em segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте часто используемые команды, а потом находите и копируйте их за секунды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sık kullandığınız komutları kaydedin, sonra saniyeler içinde arayıp kopyalayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте команди, якими часто користуєтеся, а потім знаходьте й копіюйте їх за секунди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu các lệnh bạn hay dùng, rồi tìm và sao chép chúng trong vài giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存常用命令，几秒内就能搜索并拷贝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存常用的指令，幾秒內就能搜尋並拷貝。"
          }
        }
      }
    },
    "Save usernames and passwords here. Passwords are stored in your Mac’s Keychain." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ أسماء المستخدمين وكلمات المرور هنا. تُخزَّن كلمات المرور في سلسلة مفاتيح جهاز Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere hier Benutzernamen und Passwörter. Passwörter werden im Schlüsselbund deines Macs gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda aquí nombres de usuario y contraseñas. Las contraseñas se guardan en el llavero de tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez ici vos identifiants et mots de passe. Les mots de passe sont stockés dans le trousseau de votre Mac."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמרו כאן שמות משתמש וסיסמאות. הסיסמאות נשמרות במחזיק המפתחות של ה-Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यूज़रनेम और पासवर्ड यहाँ सेव करें। पासवर्ड आपके Mac के कीचेन में सेव होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan nama pengguna dan kata sandi di sini. Kata sandi disimpan di Rantai Kunci Mac Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva qui nomi utente e password. Le password vengono salvate nel Portachiavi del Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザ名とパスワードをここに保存します。パスワードは Mac のキーチェーンに保管されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 이름과 암호를 여기에 저장하세요. 암호는 Mac의 키체인에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar hier gebruikersnamen en wachtwoorden. Wachtwoorden worden opgeslagen in de sleutelhanger van je Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj tu nazwy użytkowników i hasła. Hasła są przechowywane w pęku kluczy Twojego Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve nomes de usuário e senhas aqui. As senhas são guardadas nas Chaves do seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте здесь имена пользователей и пароли. Пароли хранятся в связке ключей вашего Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı adlarını ve parolaları buraya kaydedin. Parolalar Mac’inizin Anahtar Zinciri’nde saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте тут імена користувачів і паролі. Паролі зберігаються у В’язці ключів вашого Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu tên người dùng và mật khẩu tại đây. Mật khẩu được lưu trong Chuỗi khóa của máy Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这里保存用户名和密码。密码存储在你 Mac 的钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡儲存使用者名稱和密碼。密碼會儲存在你 Mac 的鑰匙圈中。"
          }
        }
      }
    },
