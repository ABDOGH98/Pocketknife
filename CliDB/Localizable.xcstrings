    "Search commands": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث في الأوامر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle durchsuchen"
          }
        },
        "es": {
