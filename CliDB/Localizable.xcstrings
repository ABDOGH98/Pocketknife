        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果會在你輸入時顯示在這裡。"
          }
        }
      }
    },
    "The username and password will be removed from Pocketknife and your Keychain. This can’t be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة اسم المستخدم وكلمة السر من Pocketknife ومن سلسلة المفاتيح. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername und Passwort werden aus Pocketknife und deinem Schlüsselbund entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El usuario y la contraseña se eliminarán de Pocketknife y de tu llavero. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’utilisateur et le mot de passe seront supprimés de Pocketknife et de votre trousseau. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यूज़रनेम और पासवर्ड Pocketknife और आपकी कीचेन से हटा दिए जाएँगे। इसे वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama pengguna dan kata sandi akan dihapus dari Pocketknife dan Rantai Kunci Anda. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome utente e la password verranno rimossi da Pocketknife e dal portachiavi. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザ名とパスワードがPocketknifeとキーチェーンから削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 이름과 암호가 Pocketknife와 키체인에서 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gebruikersnaam en het wachtwoord worden uit Pocketknife en je sleutelhanger verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa użytkownika i hasło zostaną usunięte z Pocketknife i pęku kluczy. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O usuário e a senha serão removidos do Pocketknife e das suas Chaves. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пользователя и пароль будут удалены из Pocketknife и связки ключей. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användarnamnet och lösenordet tas bort från Pocketknife och nyckelringen. Det går inte att ångra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อผู้ใช้และรหัสผ่านจะถูกเอาออกจาก Pocketknife และพวงกุญแจ การกระทำนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adı ve parola Pocketknife’tan ve anahtar zincirinizden kaldırılacak. Bu işlem geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên người dùng và mật khẩu sẽ bị xóa khỏi Pocketknife và Chuỗi khóa. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名和密码将从 Pocketknife 和你的钥匙串中移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者名稱和密碼將從 Pocketknife 和你的鑰匙圈中移除。此動作無法還原。"
          }
        }
      }
    },
    "This command and its saved values will be removed. This can’t be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة هذا الأمر وقيمه المحفوظة. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Befehl und seine gespeicherten Werte werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando y sus valores guardados se eliminarán. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette commande et ses valeurs enregistrées seront supprimées. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कमांड और इसके सहेजे गए मान हटा दिए जाएँगे। इसे वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah ini dan nilai tersimpannya akan dihapus. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo comando e i suoi valori salvati verranno rimossi. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコマンドと保存された値が削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 명령어와 저장된 값이 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze opdracht en de bewaarde waarden worden verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To polecenie i jego zapisane wartości zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando e seus valores salvos serão removidos. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта команда и её сохранённые значения будут удалены. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandot och dess sparade värden tas bort. Det går inte att ångra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งนี้และค่าที่บันทึกไว้จะถูกเอาออก การกระทำนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu komut ve kayıtlı değerleri kaldırılacak. Bu işlem geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lệnh này và các giá trị đã lưu sẽ bị xóa. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此命令及其存储的值将被移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此指令及其已儲存的值將被移除。此動作無法還原。"
          }
        }
      }
    },
    "This command hasn’t been added yet.": {
