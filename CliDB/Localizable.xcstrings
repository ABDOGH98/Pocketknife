    "Pick a command from the list to fill it in and copy it. Double-click a command to copy it right away, or press ⌘N to add one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أمرًا من القائمة لملئه ونسخه. انقر مرتين على أمر لنسخه فورًا، أو اضغط على ⌘N لإضافة أمر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Befehl aus der Liste, um ihn auszufüllen und zu kopieren. Doppelklicke einen Befehl, um ihn sofort zu kopieren, oder drücke ⌘N, um einen hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un comando de la lista para rellenarlo y copiarlo. Haz doble clic en un comando para copiarlo al instante, o pulsa ⌘N para añadir uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une commande dans la liste pour la remplir et la copier. Double-cliquez sur une commande pour la copier directement, ou appuyez sur ⌘N pour en ajouter une."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची से कोई कमांड चुनें, उसे भरें और कॉपी करें। तुरंत कॉपी करने के लिए किसी कमांड पर डबल-क्लिक करें, या नई जोड़ने के लिए ⌘N दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih perintah dari daftar untuk mengisi dan menyalinnya. Klik dua kali perintah untuk langsung menyalinnya, atau tekan ⌘N untuk menambahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un comando dalla lista per compilarlo e copiarlo. Fai doppio clic su un comando per copiarlo subito, oppure premi ⌘N per aggiungerne uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストからコマンドを選ぶと、入力してコピーできます。ダブルクリックするとすぐにコピーできます。⌘Nで新しいコマンドを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 명령어를 선택하여 채우고 복사하세요. 명령어를 이중 클릭하면 바로 복사되며, ⌘N을 눌러 새로 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een opdracht uit de lijst om hem in te vullen en te kopiëren. Dubbelklik op een opdracht om hem meteen te kopiëren, of druk op ⌘N om er een toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz polecenie z listy, aby je wypełnić i skopiować. Kliknij polecenie dwukrotnie, aby od razu je skopiować, lub naciśnij ⌘N, aby dodać nowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um comando na lista para preenchê-lo e copiá-lo. Clique duas vezes em um comando para copiá-lo na hora, ou pressione ⌘N para adicionar um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите команду в списке, чтобы заполнить и скопировать её. Дважды нажмите на команду, чтобы сразу скопировать её, или нажмите ⌘N, чтобы добавить новую."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett kommando i listan för att fylla i och kopiera det. Dubbelklicka på ett kommando för att kopiera det direkt, eller tryck på ⌘N för att lägga till ett."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคำสั่งจากรายการเพื่อกรอกและคัดลอก คลิกสองครั้งที่คำสั่งเพื่อคัดลอกทันที หรือกด ⌘N เพื่อเพิ่มคำสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doldurup kopyalamak için listeden bir komut seçin. Hemen kopyalamak için bir komutu çift tıklayın veya yeni eklemek için ⌘N tuşlarına basın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một lệnh trong danh sách để điền và sao chép. Bấm hai lần vào lệnh để sao chép ngay, hoặc nhấn ⌘N để thêm lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从列表中选择一个命令来填写并拷贝。连按命令可立即拷贝，或按下 ⌘N 添加新命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從列表中選擇一個指令來填寫並拷貝。按兩下指令可立即拷貝，或按下 ⌘N 加入新指令。"
          }
        }
      }
    },
    "Pick a login from the list to see it. Double-click a login to copy its password, or press ⌘N to add one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تسجيل دخول من القائمة لعرضه. انقر مرتين على تسجيل دخول لنسخ كلمة السر، أو اضغط على ⌘N لإضافة واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Login aus der Liste, um es anzuzeigen. Doppelklicke ein Login, um sein Passwort zu kopieren, oder drücke ⌘N, um eines hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un inicio de sesión de la lista para verlo. Haz doble clic en uno para copiar su contraseña, o pulsa ⌘N para añadir uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un identifiant dans la liste pour l’afficher. Double-cliquez dessus pour copier son mot de passe, ou appuyez sur ⌘N pour en ajouter un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची से कोई लॉगिन चुनें और देखें। उसका पासवर्ड कॉपी करने के लिए डबल-क्लिक करें, या नया जोड़ने के लिए ⌘N दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih login dari daftar untuk melihatnya. Klik dua kali login untuk menyalin kata sandinya, atau tekan ⌘N untuk menambahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un login dalla lista per vederlo. Fai doppio clic su un login per copiarne la password, oppure premi ⌘N per aggiungerne uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストからログインを選ぶと表示されます。ダブルクリックするとパスワードをコピーできます。⌘Nで新しいログインを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 로그인을 선택하여 확인하세요. 로그인을 이중 클릭하면 암호가 복사되며, ⌘N을 눌러 새로 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een login uit de lijst om hem te bekijken. Dubbelklik op een login om het wachtwoord te kopiëren, of druk op ⌘N om er een toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz login z listy, aby go zobaczyć. Kliknij login dwukrotnie, aby skopiować hasło, lub naciśnij ⌘N, aby dodać nowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um login na lista para vê-lo. Clique duas vezes em um login para copiar a senha, ou pressione ⌘N para adicionar um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите логин в списке, чтобы открыть его. Дважды нажмите на логин, чтобы скопировать пароль, или нажмите ⌘N, чтобы добавить новый."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en inloggning i listan för att visa den. Dubbelklicka på en inloggning för att kopiera lösenordet, eller tryck på ⌘N för att lägga till en."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกข้อมูลเข้าสู่ระบบจากรายการเพื่อดู คลิกสองครั้งเพื่อคัดลอกรหัสผ่าน หรือกด ⌘N เพื่อเพิ่มใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görmek için listeden bir giriş seçin. Parolasını kopyalamak için bir girişi çift tıklayın veya yeni eklemek için ⌘N tuşlarına basın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thông tin đăng nhập trong danh sách để xem. Bấm hai lần để sao chép mật khẩu, hoặc nhấn ⌘N để thêm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从列表中选择一个登录信息来查看。连按可拷贝其密码，或按下 ⌘N 添加新的登录信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從列表中選擇一個登入資訊來檢視。按兩下可拷貝其密碼，或按下 ⌘N 加入新的登入資訊。"
          }
        }
      }
    },
    "Pick a saved choice for %@": {
