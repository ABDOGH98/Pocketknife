    "Stored only in your Mac’s Keychain, never in Pocketknife’s own database.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزَّن فقط في سلسلة مفاتيح الـ Mac، ولا تُخزَّن أبدًا في قاعدة بيانات Pocketknife."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur im Schlüsselbund deines Mac gespeichert, nie in der Datenbank von Pocketknife."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda solo en el llavero de tu Mac, nunca en la base de datos de Pocketknife."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké uniquement dans le trousseau de votre Mac, jamais dans la base de données de Pocketknife."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ आपके Mac की कीचेन में रखा जाता है, Pocketknife के डेटाबेस में कभी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan hanya di Rantai Kunci Mac Anda, tidak pernah di database Pocketknife."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservata solo nel portachiavi del tuo Mac, mai nel database di Pocketknife."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのキーチェーンにのみ保存され、Pocketknifeのデータベースには保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 키체인에만 저장되며 Pocketknife 데이터베이스에는 저장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen bewaard in de sleutelhanger van je Mac, nooit in de database van Pocketknife."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywane tylko w pęku kluczy na Twoim Macu, nigdy w bazie danych Pocketknife."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada só nas Chaves do seu Mac, nunca no banco de dados do Pocketknife."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится только в связке ключей вашего Mac и никогда — в базе данных Pocketknife."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagras bara i nyckelringen på din Mac, aldrig i Pocketknifes egen databas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้ในพวงกุญแจของ Mac เท่านั้น ไม่เคยเก็บในฐานข้อมูลของ Pocketknife"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Mac’inizin anahtar zincirinde saklanır, asla Pocketknife’ın kendi veritabanında değil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lưu trong Chuỗi khóa của máy Mac, không bao giờ lưu trong cơ sở dữ liệu của Pocketknife."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅存储在你 Mac 的钥匙串中，从不存储在 Pocketknife 的数据库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只儲存在你 Mac 的鑰匙圈中，絕不會儲存在 Pocketknife 的資料庫中。"
          }
        }
      }
    },
