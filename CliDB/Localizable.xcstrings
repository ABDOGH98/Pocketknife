    },
    "This login has no password yet. Click Edit to add one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لتسجيل الدخول هذا كلمة سر بعد. انقر على «تحرير» لإضافة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Login hat noch kein Passwort. Klicke auf „Bearbeiten“, um eines hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este inicio de sesión aún no tiene contraseña. Haz clic en Editar para añadir una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet identifiant n’a pas encore de mot de passe. Cliquez sur Modifier pour en ajouter un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लॉगिन का अभी कोई पासवर्ड नहीं है। जोड़ने के लिए “संपादित करें” पर क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Login ini belum punya kata sandi. Klik Edit untuk menambahkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo login non ha ancora una password. Fai clic su Modifica per aggiungerne una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このログインにはまだパスワードがありません。「編集」をクリックして追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로그인에는 아직 암호가 없습니다. 편집을 클릭하여 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze login heeft nog geen wachtwoord. Klik op 'Wijzig' om er een toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten login nie ma jeszcze hasła. Kliknij Edytuj, aby je dodać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este login ainda não tem senha. Clique em Editar para adicionar uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого логина ещё нет пароля. Нажмите «Изменить», чтобы добавить его."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningen har inget lösenord än. Klicka på Redigera för att lägga till ett."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลเข้าสู่ระบบนี้ยังไม่มีรหัสผ่าน คลิก \"แก้ไข\" เพื่อเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu girişin henüz parolası yok. Eklemek için Düzenle’yi tıklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin đăng nhập này chưa có mật khẩu. Bấm Sửa để thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此登录信息还没有密码。点按“编辑”来添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此登入資訊還沒有密碼。按一下「編輯」來加入。"
          }
        }
      }
    },
