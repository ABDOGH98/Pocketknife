    "Follow macOS, or always use light or dark." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتبع إعداد macOS، أو استخدم دائماً الوضع الفاتح أو الداكن."
