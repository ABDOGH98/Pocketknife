    "A part of the command you fill in each time you copy it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزء من الأمر تملؤه في كل مرة تنسخه فيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil des Befehls, den du bei jedem Kopieren ausfüllst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte del comando que rellenas cada vez que lo copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de la commande à remplir à chaque copie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड का वह हिस्सा जिसे आप हर बार कॉपी करते समय भरते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian perintah yang Anda isi setiap kali menyalinnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte del comando da compilare ogni volta che lo copi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーするたびに入力する、コマンドの一部です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사할 때마다 채우는 명령어의 일부입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel van de opdracht dat je bij elke keer kopiëren invult."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część polecenia, którą wypełniasz przy każdym kopiowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parte do comando que você preenche sempre que o copia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть команды, которую вы заполняете при каждом копировании."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En del av kommandot som du fyller i varje gång du kopierar det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนของคำสั่งที่คุณกรอกทุกครั้งที่คัดลอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komutu her kopyaladığınızda doldurduğunuz bölüm."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phần của lệnh mà bạn điền mỗi lần sao chép."
          }
