          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I login a portata di mano, con le password al sicuro nel Portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインはすぐ手元に、パスワードはキーチェーンに安全に保管。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
