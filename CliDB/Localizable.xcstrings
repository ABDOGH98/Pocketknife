    "Tags group commands in the sidebar. Favorites get their own list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجمع الوسوم الأوامر في الشريط الجانبي. للمفضلة قائمتها الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags gruppieren Befehle in der Seitenleiste. Favoriten haben eine eigene Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas agrupan los comandos en la barra lateral. Los favoritos tienen su propia lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tags regroupent les commandes dans la barre latérale. Les favoris ont leur propre liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैग साइडबार में कमांड को समूहों में रखते हैं। पसंदीदा की अपनी सूची होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag mengelompokkan perintah di bar samping. Favorit punya daftarnya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tag raggruppano i comandi nella barra laterale. I preferiti hanno una lista tutta loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグを使うとサイドバーでコマンドをグループ化できます。お気に入りには専用のリストがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그로 사이드바에서 명령어를 그룹화합니다. 즐겨찾기는 별도의 목록이 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags groeperen opdrachten in de navigatiekolom. Favorieten hebben een eigen lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagi grupują polecenia na pasku bocznym. Ulubione mają własną listę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags agrupam comandos na barra lateral. Favoritos têm uma lista própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теги группируют команды на боковой панели. У избранного свой список."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taggar grupperar kommandon i sidofältet. Favoriter har en egen lista."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็กจัดกลุ่มคำสั่งในแถบด้านข้าง รายการโปรดมีรายการของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketler komutları kenar çubuğunda gruplar. Favorilerin kendi listesi vardır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ nhóm các lệnh trong thanh bên. Mục ưa thích có danh sách riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签可在边栏中对命令进行分组。个人收藏有单独的列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤可在側邊欄中將指令分組。個人收藏有獨立的列表。"
          }
        }
      }
    },
    "The result appears here as you type.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر النتيجة هنا أثناء الكتابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis erscheint hier, während du tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado aparece aquí mientras escribes."
          }
        },
        "fr": {
