          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विकल्प के रूप में सहेजें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan sebagai pilihan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva come opzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補として保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택지로 저장"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar als keuze"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz jako opcję"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar como opção"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить как вариант"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara som val"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเป็นตัวเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçenek olarak kaydet"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu thành lựa chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储为选项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存為選項"
          }
        }
      }
    },
    "Save the commands you use often, then search and copy them in seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ الأوامر التي تستخدمها كثيرًا، ثم ابحث عنها وانسخها في ثوانٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere deine häufig genutzten Befehle und finde und kopiere sie in Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los comandos que usas a menudo y búscalos y cópialos en segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les commandes que vous utilisez souvent, puis retrouvez-les et copiez-les en quelques secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अक्सर उपयोग होने वाली कमांड सहेजें, फिर उन्हें सेकंडों में खोजें और कॉपी करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan perintah yang sering Anda gunakan, lalu cari dan salin dalam hitungan detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i comandi che usi spesso, poi cercali e copiali in pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うコマンドを保存して、数秒で検索・コピーできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 사용하는 명령어를 저장하고 몇 초 만에 검색하고 복사하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de opdrachten die je vaak gebruikt, en zoek en kopieer ze in seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj często używane polecenia, a potem znajduj i kopiuj je w kilka sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve os comandos que você usa com frequência e busque e copie em segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте часто используемые команды, а потом находите и копируйте их за секунды."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara kommandona du använder ofta och sök och kopiera dem på några sekunder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกคำสั่งที่ใช้บ่อย แล้วค้นหาและคัดลอกได้ในไม่กี่วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık kullandığınız komutları kaydedin, sonra saniyeler içinde arayıp kopyalayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu các lệnh bạn hay dùng, sau đó tìm và sao chép chỉ trong vài giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储常用命令，然后在几秒钟内搜索并拷贝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存常用指令，然後在幾秒內搜尋並拷貝。"
          }
        }
      }
    },
    "Save usernames and passwords here. Passwords are stored in your Mac’s Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ أسماء المستخدمين وكلمات السر هنا. تُخزَّن كلمات السر في سلسلة مفاتيح الـ Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere hier Benutzernamen und Passwörter. Passwörter werden im Schlüsselbund deines Mac gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda aquí usuarios y contraseñas. Las contraseñas se guardan en el llavero de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ici vos noms d’utilisateur et mots de passe. Les mots de passe sont stockés dans le trousseau de votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ यूज़रनेम और पासवर्ड सहेजें। पासवर्ड आपके Mac की कीचेन में रखे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan nama pengguna dan kata sandi di sini. Kata sandi disimpan di Rantai Kunci Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva qui nomi utente e password. Le password sono conservate nel portachiavi del tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザ名とパスワードをここに保存します。パスワードはMacのキーチェーンに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 사용자 이름과 암호를 저장하세요. 암호는 Mac의 키체인에 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar hier gebruikersnamen en wachtwoorden. Wachtwoorden worden opgeslagen in de sleutelhanger van je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj tu nazwy użytkowników i hasła. Hasła są przechowywane w pęku kluczy na Twoim Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve usuários e senhas aqui. As senhas ficam nas Chaves do seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храните здесь имена пользователей и пароли. Пароли сохраняются в связке ключей вашего Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara användarnamn och lösenord här. Lösenorden lagras i nyckelringen på din Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกชื่อผู้ใช้และรหัสผ่านที่นี่ รหัสผ่านจะเก็บไว้ในพวงกุญแจของ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adlarını ve parolaları buraya kaydedin. Parolalar Mac’inizin anahtar zincirinde saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu tên người dùng và mật khẩu tại đây. Mật khẩu được lưu trong Chuỗi khóa của máy Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此存储用户名和密码。密码存储在你 Mac 的钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此儲存使用者名稱和密碼。密碼會儲存在你 Mac 的鑰匙圈中。"
          }
        }
      }
    },
    "Save “%@” as a choice for %@, so you can pick it next time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ «%1$@» كخيار لـ %2$@، لتتمكن من اختياره في المرة القادمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ als Auswahlwert für %2$@ sichern, um ihn nächstes Mal auszuwählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar «%1$@» como opción para %2$@, para elegirla la próxima vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer « %1$@ » comme choix pour %2$@, afin de le choisir la prochaine fois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” को %2$@ के विकल्प के रूप में सहेजें, ताकि अगली बार चुन सकें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan “%1$@” sebagai pilihan untuk %2$@, agar bisa dipilih lain kali"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva “%1$@” come opzione per %2$@, così potrai sceglierla la prossima volta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”を %2$@ の候補として保存し、次回選べるようにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’을(를) %2$@의 선택지로 저장하여 다음에 고를 수 있게 합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar '%1$@' als keuze voor %2$@, zodat je hem de volgende keer kunt kiezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz „%1$@” jako opcję dla %2$@, aby wybrać ją następnym razem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar “%1$@” como opção para %2$@, para escolher da próxima vez"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить «%1$@» как вариант для %2$@, чтобы выбрать его в следующий раз"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara ”%1$@” som val för %2$@ så att du kan välja det nästa gång"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก \"%1$@\" เป็นตัวเลือกสำหรับ %2$@ เพื่อเลือกได้ในครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” değerini %2$@ için seçenek olarak kaydet, böylece bir dahaki sefere seçebilirsiniz"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu “%1$@” thành lựa chọn cho %2$@, để lần sau có thể chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“%1$@”存储为 %2$@ 的选项，以便下次选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將「%1$@」儲存為 %2$@ 的選項，以便下次選擇"
          }
        }
      }
    },
    "Saved choices appear in a menu next to each blank, so you can pick instead of typing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الخيارات المحفوظة في قائمة بجانب كل فراغ، لتختار بدلاً من الكتابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Werte erscheinen in einem Menü neben jeder Lücke, sodass du auswählen statt tippen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones guardadas aparecen en un menú junto a cada hueco, para elegir en lugar de escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choix enregistrés apparaissent dans un menu à côté de chaque blanc, pour choisir au lieu de taper."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए विकल्प हर खाली जगह के पास एक मेनू में दिखते हैं, ताकि आप टाइप करने के बजाय चुन सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan tersimpan muncul di menu di samping setiap bagian kosong, jadi Anda bisa memilih alih-alih mengetik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le opzioni salvate compaiono in un menu accanto a ogni spazio, così puoi scegliere invece di scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した候補は各空欄の横のメニューに表示され、入力せずに選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 선택지는 각 빈칸 옆 메뉴에 나타나므로 입력 대신 고를 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaarde keuzes verschijnen in een menu naast elke lege plek, zodat je kunt kiezen in plaats van typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane opcje pojawiają się w menu obok każdej luki, więc możesz wybierać zamiast pisać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções salvas aparecem em um menu ao lado de cada lacuna, para você escolher em vez de digitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые варианты появляются в меню рядом с каждым пропуском — можно выбрать, а не печатать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade val visas i en meny bredvid varje lucka så att du kan välja i stället för att skriva."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกที่บันทึกไว้จะแสดงในเมนูข้างช่องว่างแต่ละช่อง คุณจึงเลือกแทนการพิมพ์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı seçenekler her boşluğun yanındaki menüde görünür; yazmak yerine seçebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lựa chọn đã lưu hiện trong menu bên cạnh mỗi chỗ trống, để bạn chọn thay vì gõ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储的选项会出现在每个空格旁的菜单中，可直接选择而无需输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的選項會出現在每個空格旁的選單中，可直接選擇而不必輸入。"
          }
        }
      }
    },
