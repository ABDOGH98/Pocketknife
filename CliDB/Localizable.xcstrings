    "Wrap the parts that change in double curly braces:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع الأجزاء المتغيرة بين أقواس معقوفة مزدوجة:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze die veränderlichen Teile in doppelte geschweifte Klammern:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encierra las partes que cambian entre llaves dobles:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entourez les parties variables de doubles accolades :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलने वाले हिस्सों को दोहरे कर्ली ब्रैकेट में रखें:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apit bagian yang berubah dengan kurung kurawal ganda:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Racchiudi le parti che cambiano tra doppie parentesi graffe:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変わる部分を二重の波かっこで囲みます："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바뀌는 부분을 이중 중괄호로 감싸세요:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de delen die veranderen tussen dubbele accolades:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujmij zmieniające się części w podwójne nawiasy klamrowe:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque as partes que mudam entre chaves duplas:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заключите изменяемые части в двойные фигурные скобки:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätt delarna som ändras inom dubbla klammerparenteser:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครอบส่วนที่เปลี่ยนแปลงด้วยวงเล็บปีกกาคู่:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişen bölümleri çift süslü ayraç içine alın:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt các phần thay đổi trong cặp ngoặc nhọn kép:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将会变化的部分用双大括号括起来："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將會變化的部分用雙大括號括起來："
          }
        }
      }
    },
    "Your edits to this command will be lost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستفقد تعديلاتك على هذا الأمر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen an diesem Befehl gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán tus cambios en este comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications de cette commande seront perdues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कमांड में किए गए आपके बदलाव खो जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan Anda pada perintah ini akan hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche a questo comando andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコマンドへの変更は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 명령어에 대한 변경 사항이 손실됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wijzigingen aan deze opdracht gaan verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany w tym poleceniu zostaną utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas alterações neste comando serão perdidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши изменения этой команды будут потеряны."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina ändringar i kommandot försvinner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแก้ไขคำสั่งนี้ของคุณจะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu komuttaki değişiklikleriniz kaybolacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thay đổi của bạn với lệnh này sẽ bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你对此命令的更改将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你對此指令的變更將會遺失。"
          }
        }
      }
    },
