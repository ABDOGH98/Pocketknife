    "Pocketknife": {
      "shouldTranslate": false
    },
    "Pocketknife restarts to apply a new language.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعاد تشغيل Pocketknife لتطبيق لغة جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife startet neu, um eine neue Sprache zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife se reinicia para aplicar un idioma nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife redémarre pour appliquer une nouvelle langue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई भाषा लागू करने के लिए Pocketknife फिर से शुरू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife dimulai ulang untuk menerapkan bahasa baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife si riavvia per applicare una nuova lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語を適用するためにPocketknifeが再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 언어를 적용하려면 Pocketknife가 재시동됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife start opnieuw op om een nieuwe taal te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife uruchamia się ponownie, aby zastosować nowy język."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pocketknife reinicia para aplicar um novo idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife перезапускается, чтобы применить новый язык."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife startar om för att använda ett nytt språk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife จะเริ่มใหม่เพื่อใช้ภาษาใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife yeni bir dili uygulamak için yeniden başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife sẽ khởi động lại để áp dụng ngôn ngữ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife 会重新启动以应用新语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife 會重新啟動以套用新語言。"
          }
        }
      }
    },
    "Pocketknife will close and reopen. Unsaved changes in open editors will be lost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُغلق Pocketknife ثم يُفتح من جديد. ستفقد التغييرات غير المحفوظة في المحررات المفتوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife wird geschlossen und wieder geöffnet. Nicht gesicherte Änderungen in offenen Editoren gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife se cerrará y se volverá a abrir. Se perderán los cambios sin guardar de los editores abiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife va se fermer puis se rouvrir. Les modifications non enregistrées dans les éditeurs ouverts seront perdues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife बंद होकर फिर से खुलेगा। खुले एडिटर में बिना सहेजे बदलाव खो जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife akan ditutup dan dibuka kembali. Perubahan yang belum disimpan di editor yang terbuka akan hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife verrà chiuso e riaperto. Le modifiche non salvate negli editor aperti andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknifeが終了して再度開きます。開いているエディタの保存されていない変更は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife가 종료된 후 다시 열립니다. 열려 있는 편집기의 저장하지 않은 변경 사항은 손실됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife wordt gesloten en opnieuw geopend. Niet-bewaarde wijzigingen in open editors gaan verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife zostanie zamknięty i otwarty ponownie. Niezapisane zmiany w otwartych edytorach zostaną utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pocketknife será fechado e reaberto. Alterações não salvas em editores abertos serão perdidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife закроется и откроется снова. Несохранённые изменения в открытых редакторах будут потеряны."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife stängs och öppnas igen. Osparade ändringar i öppna redigerare försvinner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife จะปิดแล้วเปิดใหม่ การเปลี่ยนแปลงที่ยังไม่ได้บันทึกในตัวแก้ไขที่เปิดอยู่จะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife kapanıp yeniden açılacak. Açık düzenleyicilerdeki kaydedilmemiş değişiklikler kaybolacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife sẽ đóng rồi mở lại. Các thay đổi chưa lưu trong trình sửa đang mở sẽ bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife 将关闭并重新打开。已打开编辑器中未存储的更改将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketknife 將關閉並重新打開。已打開編輯器中未儲存的變更將會遺失。"
          }
        }
      }
    },
