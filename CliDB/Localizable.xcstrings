            "state": "translated",
            "value": "Neye ihtiyacınız var?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cần gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要什麼？"
          }
        }
      }
    },
    "What you type here goes into the highlighted parts of the command above, and is remembered for next time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تكتبه هنا يدخل في الأجزاء المميزة من الأمر أعلاه، ويُحفظ للمرة القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du hier eingibst, wird in die hervorgehobenen Teile des Befehls oben eingesetzt und fürs nächste Mal gemerkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribas aquí va en las partes resaltadas del comando de arriba, y se recuerda para la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous saisissez ici remplace les parties surlignées de la commande ci-dessus, et est conservé pour la prochaine fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप यहाँ जो टाइप करते हैं, वह ऊपर कमांड के हाइलाइट किए गए हिस्सों में जाता है, और अगली बार के लिए याद रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang Anda ketik di sini masuk ke bagian perintah yang disorot di atas, dan diingat untuk lain kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che scrivi qui va nelle parti evidenziate del comando sopra, e viene ricordato per la prossima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに入力した内容は上のコマンドの強調表示された部分に入り、次回のために記憶されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 입력한 내용은 위 명령어의 강조 표시된 부분에 들어가며 다음을 위해 기억됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je hier typt, komt in de gemarkeerde delen van de opdracht hierboven en wordt onthouden voor de volgende keer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co tu wpiszesz, trafi do wyróżnionych części polecenia powyżej i zostanie zapamiętane na następny raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você digitar aqui entra nas partes destacadas do comando acima, e fica salvo para a próxima vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что вы введёте здесь, подставится в выделенные части команды выше и запомнится на следующий раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du skriver här hamnar i de markerade delarna av kommandot ovan och kommer ihåg till nästa gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณพิมพ์ที่นี่จะใส่ลงในส่วนที่ไฮไลท์ของคำสั่งด้านบน และจะถูกจำไว้สำหรับครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya yazdıklarınız yukarıdaki komutun vurgulanan bölümlerine girer ve bir dahaki sefer için hatırlanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì bạn nhập ở đây sẽ điền vào các phần được tô sáng của lệnh ở trên, và được ghi nhớ cho lần sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在这里输入的内容会填入上方命令中高亮的部分，并在下次自动记住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在這裡輸入的內容會填入上方指令中反白的部分，並在下次自動記住。"
          }
        }
      }
    },
