    "The username and password will be removed from Pocketknife and your Keychain. This can’t be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف اسم المستخدم وكلمة المرور من Pocketknife ومن سلسلة المفاتيح. لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzername und Passwort werden aus Pocketknife und deinem Schlüsselbund entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario y la contraseña se eliminarán de Pocketknife y de tu llavero. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identifiant et le mot de passe seront supprimés de Pocketknife et de votre trousseau. Cette action est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שם המשתמש והסיסמה יוסרו מ-Pocketknife וממחזיק המפתחות. לא ניתן לבטל פעולה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यूज़रनेम और पासवर्ड Pocketknife और आपके कीचेन से हटा दिए जाएँगे। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama pengguna dan kata sandi akan dihapus dari Pocketknife dan Rantai Kunci Anda. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome utente e la password verranno rimossi da Pocketknife e dal Portachiavi. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザ名とパスワードが Pocketknife とキーチェーンから削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 이름과 암호가 Pocketknife와 키체인에서 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gebruikersnaam en het wachtwoord worden verwijderd uit Pocketknife en je sleutelhanger. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa użytkownika i hasło zostaną usunięte z Pocketknife i z pęku kluczy. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de usuário e a senha serão removidos do Pocketknife e das suas Chaves. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользователя и пароль будут удалены из Pocketknife и связки ключей. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı adı ve parola Pocketknife’tan ve Anahtar Zinciri’nizden silinecek. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ім’я користувача й пароль буде видалено з Pocketknife і з В’язки ключів. Цю дію не можна скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên người dùng và mật khẩu sẽ bị xóa khỏi Pocketknife và Chuỗi khóa của bạn. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户名和密码将从 Pocketknife 和你的钥匙串中移除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用者名稱和密碼將從 Pocketknife 和你的鑰匙圈中移除。此動作無法還原。"
          }
        }
      }
    },
