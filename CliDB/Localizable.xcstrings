    "Save a command once, then fill in the blanks and copy it any time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ الأمر مرة واحدة، ثم املأ الفراغات وانسخه في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere einen Befehl einmal, fülle dann die Lücken aus und kopiere ihn jederzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un comando una vez y luego rellena los huecos y cópialo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une commande une fois, puis remplissez les blancs et copiez-la quand vous voulez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड एक बार सहेजें, फिर खाली जगहें भरकर कभी भी कॉपी करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan perintah sekali, lalu isi bagian yang kosong dan salin kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un comando una volta, poi compila gli spazi e copialo quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドを一度保存すれば、あとは空欄を埋めていつでもコピーできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령어를 한 번 저장한 다음 빈칸을 채워 언제든지 복사하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar een opdracht één keer, vul daarna de lege plekken in en kopieer hem wanneer je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz polecenie raz, a potem wypełniaj luki i kopiuj je w dowolnej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve um comando uma vez, depois preencha as lacunas e copie quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните команду один раз, а затем заполняйте пропуски и копируйте её в любой момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara ett kommando en gång, fyll sedan i luckorna och kopiera det när du vill."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกคำสั่งครั้งเดียว แล้วเติมช่องว่างและคัดลอกได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir komutu bir kez kaydedin, sonra boşlukları doldurup istediğiniz zaman kopyalayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu lệnh một lần, sau đó điền chỗ trống và sao chép bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需存储一次命令，之后填空即可随时拷贝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需儲存一次指令，之後填空即可隨時拷貝。"
          }
        }
      }
    },
