    "Click the star on a command, or press ⇧⌘F, to keep it here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على النجمة بجانب الأمر أو اضغط على ⇧⌘F لإبقائه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den Stern eines Befehls oder drücke ⇧⌘F, um ihn hier zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la estrella de un comando o pulsa ⇧⌘F para guardarlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’étoile d’une commande ou appuyez sur ⇧⌘F pour la garder ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कमांड पर स्टार क्लिक करें या ⇧⌘F दबाएँ, ताकि वह यहाँ रहे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik bintang pada perintah, atau tekan ⇧⌘F, untuk menyimpannya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sulla stella di un comando o premi ⇧⌘F per tenerlo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの星をクリックするか ⇧⌘F を押すと、ここに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령어의 별을 클릭하거나 ⇧⌘F를 누르면 여기에 보관됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de ster van een opdracht of druk op ⇧⌘F om hem hier te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij gwiazdkę przy poleceniu lub naciśnij ⇧⌘F, aby je tu zachować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na estrela de um comando ou pressione ⇧⌘F para mantê-lo aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите звёздочку у команды или ⇧⌘F, чтобы она появилась здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på stjärnan på ett kommando eller tryck på ⇧⌘F för att spara det här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกดาวที่คำสั่ง หรือกด ⇧⌘F เพื่อเก็บไว้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir komutu burada tutmak için yıldızını tıklayın veya ⇧⌘F tuşlarına basın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào ngôi sao trên một lệnh hoặc nhấn ⇧⌘F để giữ lệnh ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按命令上的星标或按下 ⇧⌘F，即可将其保留在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下指令上的星號或按下 ⇧⌘F，即可將其保留在這裡。"
          }
        }
      }
    },
