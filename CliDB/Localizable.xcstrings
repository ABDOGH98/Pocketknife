    "Use - and _ instead of + and /, without = padding": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم - و_ بدلاً من + و/، دون حشو ="
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "- und _ statt + und / verwenden, ohne =-Auffüllung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar - y _ en lugar de + y /, sin relleno ="
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser - et _ au lieu de + et /, sans remplissage ="
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "+ और / की जगह - और _ इस्तेमाल करें, = पैडिंग के बिना"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan - dan _ sebagai pengganti + dan /, tanpa padding ="
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa - e _ invece di + e /, senza padding ="
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ と / の代わりに - と _ を使い、= のパディングを省きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 및 / 대신 - 및 _를 사용하고 = 패딩 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik - en _ in plaats van + en /, zonder =-opvulling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj - i _ zamiast + i /, bez dopełnienia ="
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar - e _ em vez de + e /, sem preenchimento ="
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать - и _ вместо + и /, без дополнения ="
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd - och _ i stället för + och /, utan =-utfyllnad"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ - และ _ แทน + และ / โดยไม่มีการเติม ="
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "+ ve / yerine - ve _ kullan, = dolgusu olmadan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng - và _ thay cho + và /, không có phần đệm ="
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
