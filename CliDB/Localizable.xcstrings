          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui macOS, oppure usa sempre la modalità chiara o scura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS に合わせるか、常にライトまたはダークを使用します。"
