    "Free and open source. Everything stays on your Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجاني ومفتوح المصدر. كل شيء يبقى على جهاز Mac الخاص بك."
          }
        },
