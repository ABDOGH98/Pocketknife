    "Choose one from the list to fill it in and copy it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أمراً من القائمة لتعبئته ونسخه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige uno de la lista para completarlo y copiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en une dans la liste pour la remplir et la copier."
          }
        }
      }
    },
