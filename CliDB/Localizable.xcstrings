    "Copied passwords are hidden from clipboard managers and cleared after a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات المرور المنسوخة مخفية عن مديري الحافظة وتُمسح بعد دقيقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas copiadas se ocultan a los gestores de portapapeles y se borran tras un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de passe copiés sont masqués aux gestionnaires de presse-papiers et effacés au bout d’une minute."
          }
        }
      }
    },
