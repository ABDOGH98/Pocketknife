        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 설정을 따르거나 항상 라이트 또는 다크를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
