    "Invalid Base64: the input contains characters or padding that can’t be decoded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Base64 غير صالح: يحتوي الإدخال على أحرف أو حشو لا يمكن فك ترميزه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiges Base64: Die Eingabe enthält Zeichen oder Auffüllung, die nicht dekodiert werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Base64 no válido: la entrada contiene caracteres o relleno que no se pueden decodificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Base64 non valide : l’entrée contient des caractères ou un remplissage impossibles à décoder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमान्य Base64: इनपुट में ऐसे वर्ण या पैडिंग हैं जिन्हें डिकोड नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Base64 tidak valid: input berisi karakter atau padding yang tidak dapat didekode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Base64 non valido: l’input contiene caratteri o padding non decodificabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なBase64：デコードできない文字またはパディングが含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효하지 않은 Base64: 디코딩할 수 없는 문자나 패딩이 포함되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeldige Base64: de invoer bevat tekens of opvulling die niet gedecodeerd kunnen worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowe Base64: dane zawierają znaki lub dopełnienie, których nie można zdekodować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Base64 inválido: a entrada contém caracteres ou preenchimento que não podem ser decodificados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимый Base64: в данных есть символы или дополнение, которые нельзя декодировать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogiltig Base64: indatan innehåller tecken eller utfyllnad som inte kan avkodas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Base64 ไม่ถูกต้อง: อินพุตมีอักขระหรือการเติมที่ถอดรหัสไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz Base64: girdi çözülemeyen karakterler veya dolgu içeriyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Base64 không hợp lệ: đầu vào chứa ký tự hoặc phần đệm không thể giải mã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的 Base64：输入中包含无法解码的字符或填充。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無效的 Base64：輸入中包含無法解碼的字元或填補。"
          }
        }
      }
    },
