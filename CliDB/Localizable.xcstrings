    "Good. 16+ characters with symbols would be stronger.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جيدة. 16 حرفًا أو أكثر مع رموز ستكون أقوى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut. 16+ Zeichen mit Sonderzeichen wären stärker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien. 16 o más caracteres con símbolos sería más segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien. 16 caractères ou plus avec des symboles seraient plus sûrs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अच्छा। सिंबल के साथ 16+ वर्ण और मज़बूत होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagus. 16+ karakter dengan simbol akan lebih kuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bene. 16+ caratteri con simboli sarebbero più sicuri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "良好です。記号を含む16文字以上ならさらに強力です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋습니다. 기호를 포함한 16자 이상이면 더 강력합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goed. 16+ tekens met symbolen zou sterker zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrze. 16+ znaków z symbolami byłoby silniejsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bom. 16+ caracteres com símbolos seria mais forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошо. 16+ символов со спецсимволами было бы надёжнее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra. 16+ tecken med symboler vore starkare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดี ถ้ามี 16 ตัวอักษรขึ้นไปพร้อมสัญลักษณ์จะรัดกุมกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi. Semboller içeren 16+ karakter daha güçlü olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốt. 16+ ký tự có ký hiệu sẽ mạnh hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不错。16 个以上字符并包含符号会更强。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不錯。16 個以上字元並包含符號會更強。"
          }
        }
      }
    },
