            "value": "인코딩할 텍스트나 디코딩할 Base64를 붙여넣으세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak tekst om te coderen, of Base64 om te decoderen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej tekst do zakodowania lub Base64 do zdekodowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole texto para codificar, ou Base64 para decodificar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте текст для кодирования или Base64 для декодирования"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in text att koda, eller Base64 att avkoda"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางข้อความที่จะเข้ารหัส หรือ Base64 ที่จะถอดรหัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodlanacak metni veya çözülecek Base64’ü yapıştırın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán văn bản cần mã hóa, hoặc Base64 cần giải mã"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴要编码的文本，或要解码的 Base64"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上要編碼的文字，或要解碼的 Base64"
          }
        }
      }
    },
